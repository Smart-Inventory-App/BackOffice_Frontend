# URL of the backoffice backend
VITE_API_URL=http://localhost:8002

# ID del cliente "Aplicación web" de Google Cloud (el mismo que usa la app como webClientId y el servicio auth como
# GOOGLE_CLIENT_ID). Vacío = no se muestra "Continuar con Google". En Google Cloud hay que autorizar el origen del dashboard.
VITE_GOOGLE_CLIENT_ID=
